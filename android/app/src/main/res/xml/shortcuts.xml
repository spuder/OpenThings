<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcuts (press and hold the app icon). Each opens an openthings:// link
     (docs/url-scheme.md), handled like any other link by src/lib/native/links.ts. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.spuder.openthings"
            android:targetClass="io.github.spuder.openthings.MainActivity"
            android:data="openthings://add" />
    </shortcut>
    <shortcut
        android:shortcutId="today"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_today"
        android:shortcutShortLabel="@string/shortcut_today">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.spuder.openthings"
            android:targetClass="io.github.spuder.openthings.MainActivity"
            android:data="openthings://today" />
    </shortcut>
    <shortcut
        android:shortcutId="inbox"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_inbox"
        android:shortcutShortLabel="@string/shortcut_inbox">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.spuder.openthings"
            android:targetClass="io.github.spuder.openthings.MainActivity"
            android:data="openthings://inbox" />
    </shortcut>
    <shortcut
        android:shortcutId="upcoming"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_upcoming"
        android:shortcutShortLabel="@string/shortcut_upcoming">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.spuder.openthings"
            android:targetClass="io.github.spuder.openthings.MainActivity"
            android:data="openthings://upcoming" />
    </shortcut>
</shortcuts>
