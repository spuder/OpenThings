<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Shared by the app, widget and share extension targets. The group id comes from
     OT_APP_GROUP in OpenThings.xcconfig. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(OT_APP_GROUP)</string>
	</array>
</dict>
</plist>
