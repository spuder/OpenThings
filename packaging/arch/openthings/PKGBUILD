# Maintainer: Spencer Owen <owenspencer at gmail dot com>
#
# Builds OpenThings (Tauri desktop app) from a release tag.
# pkgver follows the app version (scripts/bump-version.sh). Checksums stay SKIP here: the release
# workflow (.github/workflows/arch-publish.yml) fills them in before publishing to the AUR and the
# pacman repo.
pkgname=openthings
pkgver=0.11.0
pkgrel=1
pkgdesc='Self-hosted, local-first task manager with a calm, keyboard-first design'
arch=('x86_64' 'aarch64')
url='https://github.com/spuder/OpenThings'
license=('MIT')
# libayatana-appindicator is loaded at runtime for the tray icon (namcap can't see that).
depends=('cairo' 'dbus' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme' 'libayatana-appindicator' 'libgcc' 'libsoup3' 'webkit2gtk-4.1')
makedepends=('cargo' 'nodejs' 'npm')
optdepends=('notification-daemon: reminder notifications (mako, dunst, swaync, …)'
            'xdg-utils: open openthings:// links')
conflicts=('openthings-bin')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/spuder/OpenThings/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

_srcdir() { echo "$srcdir/OpenThings-$pkgver"; }

prepare() {
  cd "$(_srcdir)"
  export npm_config_cache="$srcdir/npm-cache"
  npm ci --no-audit --no-fund
  cd src-tauri
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_srcdir)"
  export npm_config_cache="$srcdir/npm-cache"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$(_srcdir)/src-tauri/target"
  # Builds the web app (npm run build) and the release binary; no .deb/AppImage bundling.
  npx tauri build --no-bundle -- --locked
}

package() {
  cd "$(_srcdir)"
  install -Dm755 src-tauri/target/release/openthings "$pkgdir/usr/bin/openthings"
  install -Dm644 packaging/arch/openthings.desktop "$pkgdir/usr/share/applications/openthings.desktop"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/openthings.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/openthings.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/openthings.png"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/openthings.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
