{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenThings",
  "mainBinaryName": "openthings",
  "version": "0.8.0",
  "identifier": "io.github.spuder.openthings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenThings",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "Local-first task manager",
    "longDescription": "OpenThings is a self-hosted, local-first task manager with a calm, keyboard-first design: Today, Upcoming, Areas and Projects, habits, a Pomodoro, reminders and a 48-hour brain dump.",
    "copyright": "MIT License, OpenThings contributors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "linux/openthings.desktop.hbs"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["openthings"]
      }
    }
  }
}
